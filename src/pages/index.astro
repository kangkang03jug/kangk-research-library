---
import Layout from '../layouts/Layout.astro';
import { getProfile, getPapers, getStates, getDaily } from '../lib/data';
import { stats } from '../lib/library';
import { withBase } from '../lib/url';
const profile = getProfile(); const papers = getPapers(); const states = getStates(); const daily = getDaily(); const summary = stats(papers, states, daily);
const today = summary.today?.recommendations.find((r) => r.primary); const todayPaper = papers.find((p) => p.id === today?.paper_id);
---
<Layout title="Home" profile={profile}>
  <section class="hero"><p class="eyebrow"><span data-i18n="home.eyebrow">Research Library ·</span> {profile.profile.researcher}</p><h1>{profile.profile.library_name}</h1><p class="lede" data-i18n="home.lede">一个持续更新的个人研究知识库，用于整理论文、记录阅读进展，并沉淀长期研究笔记与思考。</p></section>
  <section class="today" aria-labelledby="today-heading">
    <div><div class="section-label"><h2 id="today-heading" data-i18n="home.today">今日论文</h2><span class="count">{profile.daily.scheduled_time} · {profile.daily.timezone}</span></div>
      {todayPaper ? <div class="today-paper"><div class="meta-line"><span>{todayPaper.year}</span><span>{todayPaper.venue_or_source}</span><span>{todayPaper.relevance}</span></div><h2>{todayPaper.title}</h2><p class="authors">{todayPaper.authors.join(' · ')}</p><p>{todayPaper.quick_read.tldr}</p><a class="cta" href={withBase(`/papers/${todayPaper.id}/`, import.meta.env.BASE_URL)} data-i18n="home.read">阅读论文 →</a></div> : <div class="empty"><strong data-i18n="home.noPapers">还没有论文。</strong><span data-i18n="home.agentWillAdd">研究 Agent 将在下一次运行时添加第一篇论文。</span></div>}
    </div>
    <div data-local-paper-ids hidden>{papers.map((paper) => <span data-paper-id={paper.id}></span>)}</div><div><div class="section-label"><h2 data-i18n="home.glance">概览</h2></div><div class="stats"><div class="stat"><span class="stat-value">{summary.total}</span><span class="stat-label" data-i18n="stats.total">论文总数</span></div><div class="stat"><span class="stat-value" data-local-stat="deep_read">{summary.deepRead}</span><span class="stat-label" data-i18n="stats.deepRead">已精读</span></div><div class="stat"><span class="stat-value">{summary.thisMonth}</span><span class="stat-label" data-i18n="stats.thisMonth">本月新增</span></div><div class="stat"><span class="stat-value">{summary.preprints}</span><span class="stat-label" data-i18n="stats.preprints">预印本</span></div></div></div>
  </section>
</Layout>
