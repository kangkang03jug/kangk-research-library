---
import Layout from '../layouts/Layout.astro'; import PaperCard from '../components/PaperCard.astro'; import { getProfile, getPapers, getStates } from '../lib/data'; import { joinState } from '../lib/library';
const profile = getProfile(); const joined = joinState(getPapers(), getStates()); const papers = joined.map((x) => x.paper); const topics = [...new Set(papers.flatMap((p) => p.topics))].sort(); const venues = [...new Set(papers.map((p) => p.venue_or_source))].sort(); const years = [...new Set(papers.map((p) => p.year))].sort((a,b) => b-a);
---
<Layout title="Paper Pool" profile={profile}><section class="page-head"><div><p class="eyebrow">Library index</p><h1>Paper Pool</h1><p class="lede">Every paper in the library, with the context you need to decide what comes next.</p></div><span class="count" data-result-count>{papers.length} papers</span></section>
  <div class="toolbar"><input class="search" type="search" placeholder="Search title, method, authors, notes…" aria-label="Search papers" data-search /><div class="filters"><label>Topic<select data-filter="topic"><option value="all">All topics</option>{topics.map((x) => <option value={x}>{x}</option>)}</select></label><label>Venue / Source<select data-filter="venue"><option value="all">All venues</option>{venues.map((x) => <option value={x}>{x}</option>)}</select></label><label>Year<select data-filter="year"><option value="all">All years</option>{years.map((x) => <option value={x}>{x}</option>)}</select></label><label>Relevance<select data-filter="relevance"><option value="all">All levels</option><option>High</option><option>Medium</option><option>Low</option></select></label><label>Deep Read<select data-filter="deep-read"><option value="all">Any</option><option value="true">Yes</option><option value="false">No</option></select></label><label>Favorite<select data-filter="favorite"><option value="all">Any</option><option value="true">Yes</option><option value="false">No</option></select></label><label>Sort<select data-sort><option value="recent">Recently Added</option><option value="publication">Publication Date</option><option value="relevance">Relevance</option><option value="ranking">Venue Ranking</option><option value="title">Title</option></select></label></div></div>
  {papers.length ? <div class="paper-list">{joined.map(({ paper, state }) => <PaperCard paper={paper} state={state} />)}</div> : <div class="empty"><strong>No papers yet.</strong>The Paper Pool is ready for your first research agent run.</div>}<script src="../scripts/library.js"></script></Layout>
