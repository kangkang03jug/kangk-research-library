---
import Layout from '../../layouts/Layout.astro'; import { getProfile, getPapers, getStates } from '../../lib/data'; import { readingBasisLabel } from '../../lib/library';
export function getStaticPaths() { return getPapers().map((paper) => ({ params: { id: paper.id }, props: { paper, state: getStates().find((s) => s.paper_id === paper.id) } })); }
const { paper, state } = Astro.props; const base=import.meta.env.BASE_URL; const rank=paper.ranking.ccf || paper.ranking.cas || paper.ranking.jcr || 'Unknown'; const profile=getProfile();
---
<Layout title={paper.title} profile={profile}><article class="paper-head"><a class="eyebrow" href={`${base}paper-pool/`}>← Back to Paper Pool</a><div class="paper-kicker"><span>{paper.year}</span><span>{paper.venue_or_source}</span><span>{rank}</span><span class={`relevance relevance-${paper.relevance.toLowerCase()}`}>{paper.relevance} relevance</span></div><h1>{paper.title}</h1><p class="authors">{paper.authors.join(' · ')}</p><p class="reading-basis">Reading Basis: <strong>{readingBasisLabel[paper.reading_basis]}</strong></p><div class="paper-links"><a href={paper.urls.paper} target="_blank" rel="noreferrer">Paper ↗</a>{paper.urls.code && <a href={paper.urls.code} target="_blank" rel="noreferrer">Code ↗</a>}{paper.identifiers.doi && <span>DOI: {paper.identifiers.doi}</span>}</div></article>
  <div class="read-grid"><div class="reading-content"><section class="quick-read"><p class="eyebrow">1–3 minute read</p><h2>Quick Read</h2><span class="fact-label">TL;DR</span><p>{paper.quick_read.tldr}</p><span class="fact-label">Problem & Motivation</span><p>{paper.quick_read.problem_and_motivation}</p><span class="fact-label">Core Method</span><p>{paper.quick_read.core_method}</p><span class="fact-label">Key Results</span><p>{paper.quick_read.key_results}</p><span class="fact-label">Why It Matters · AI analysis</span><p class="analysis">{paper.quick_read.why_it_matters}</p><button class="read-detail-button" data-read-detail>Read Detail ↓</button></section>
    <div class="detail-wrap" data-detail hidden><section class="detail-section" id="motivation" tabindex="-1"><h2>Motivation</h2><p>{paper.detail.motivation}</p></section><section class="detail-section" id="research-questions"><h2>Research Questions</h2>{paper.detail.research_questions.length ? paper.detail.research_questions.map((rq)=><dl class="rq"><dt>{rq.question}</dt><dd><strong>How:</strong> {rq.how}</dd><dd><strong>Answer:</strong> {rq.answer}</dd><dd><strong>Meaning:</strong> {rq.meaning}</dd>{rq.source && <dd><strong>Source:</strong> {rq.source}</dd>}</dl>) : <p>The paper does not explicitly define Research Questions.</p>}</section><section class="detail-section" id="method"><h2>Method</h2><p>{paper.detail.method}</p></section><section class="detail-section" id="experiments"><h2>Experiments & Key Findings</h2><p>{paper.detail.experiments_and_key_findings}</p></section><section class="detail-section" id="limitations"><h2>Limitations</h2><span class="fact-label">Author-reported</span><ul>{paper.detail.limitations.author_reported.map((x)=><li>{x}</li>)}</ul><span class="fact-label">AI analysis</span><div class="analysis"><ul>{paper.detail.limitations.ai_analysis.map((x)=><li>{x}</li>)}</ul></div></section><section class="detail-section" id="relation"><h2>Relation to Research</h2><p class="analysis">{paper.detail.relation_to_research}</p></section><section class="detail-section" id="next"><h2>What Can Be Done Next</h2><p class="analysis">{paper.detail.what_can_be_done_next}</p></section><section class="detail-section" id="abstract"><details class="abstract"><summary>Original Abstract</summary><p>{paper.original_abstract || 'No abstract was stored.'}</p></details>{paper.bibtex && <details class="bibtex"><summary>BibTeX</summary><pre>{paper.bibtex}</pre><button class="text-button" data-copy-bibtex>Copy BibTeX</button></details>}</section></div>
    <div class="editor-panel" data-editor data-api={import.meta.env.PUBLIC_EDITOR_API_URL || ''}><h2>Owner editing</h2><p class="editor-status" data-editor-status>Checking secure editor…</p><div class="editor-actions"><button data-edit-action type="button">Mark as Deep Read</button><button data-edit-action type="button">Favorite</button><button data-edit-action type="button">Edit status</button><button data-edit-action type="button">Edit AI content</button></div><label>My Notes<textarea class="notes-area" data-notes placeholder="Private, durable Markdown notes…">{state?.my_notes || ''}</textarea></label><p class="editor-status">My Notes and My Tags are stored separately from generated paper content. Writes require GitHub owner authentication.</p></div>
  </div><aside class="toc"><strong>On this page</strong><a href="#motivation">Motivation</a><a href="#research-questions">Research Questions</a><a href="#method">Method</a><a href="#experiments">Experiments & Key Findings</a><a href="#limitations">Limitations</a><a href="#relation">Relation to Research</a><a href="#next">What Can Be Done Next</a><a href="#abstract">Original Abstract</a></aside></div><div class="paper-footer-meta"><span>Added: {paper.generated_at.slice(0,10)}</span><span>Last Updated: {paper.updated_at.slice(0,10)}</span><span>Summary generated by {paper.generated_by}</span>{paper.owner_edited && <span>Edited by owner</span>}</div><script src="../../scripts/library.js"></script></Layout>
