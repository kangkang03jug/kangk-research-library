---
import Layout from '../../layouts/Layout.astro';
import { getProfile, getPapers } from '../../lib/data';
import { readingBasisLabel } from '../../lib/library';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return getPapers().map((paper) => ({
    params: { id: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const base = import.meta.env.BASE_URL;
const rank = paper.ranking.ccf || paper.ranking.cas || paper.ranking.jcr || 'Unknown';
const profile = getProfile();
const editorApi = import.meta.env.PUBLIC_EDITOR_API_URL || profile?.editor?.api_origin || '';
const asParagraphs = (value: string) =>
  value
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
const nextSteps = Array.isArray(paper.detail.what_can_be_done_next)
  ? paper.detail.what_can_be_done_next
  : [
      {
        title: 'Next steps',
        rationale: 'This legacy record predates structured follow-up directions.',
        concrete_plan: paper.detail.what_can_be_done_next,
        validation: "Use the paper's reported datasets, baselines, and metrics.",
        expected_value: 'Make the next experiment directly comparable with the paper.',
        source: null,
      },
    ];
---
<Layout title={paper.title} profile={profile}>
  <article class="paper-head">
    <a class="eyebrow" href={withBase('/paper-pool/', base)} data-i18n="paper.backToPool">← 返回论文池</a>
    <div class="paper-kicker"><span>{paper.year}</span><span>{paper.venue_or_source}</span><span>{rank}</span><span class={`relevance relevance-${paper.relevance.toLowerCase()}`}>{paper.relevance}</span></div>
    <h1>{paper.title}</h1>
    <p class="authors">{paper.authors.join(' · ')}</p>
    <p class="reading-basis"><span data-i18n="paper.readingBasis">阅读依据：</span><strong>{readingBasisLabel[paper.reading_basis]}</strong></p>
    <div class="paper-links"><a href={paper.urls.paper} target="_blank" rel="noreferrer" data-i18n="paper.paper">论文 ↗</a>{paper.urls.code && <a href={paper.urls.code} target="_blank" rel="noreferrer" data-i18n="paper.code">代码 ↗</a>}{paper.identifiers.doi && <span>DOI: {paper.identifiers.doi}</span>}</div>
  </article>
  <div class="read-grid">
    <div class="reading-content">
      <div class="local-reading-state" data-local-paper-state data-paper-id={paper.id}><strong data-i18n="paper.localReadingState">本浏览器阅读状态</strong><label><input type="checkbox" data-local-field="deep_read" /> <span data-i18n="paper.markDeepRead">标记为精读</span></label><label><input type="checkbox" data-local-field="favorite" /> <span data-i18n="paper.favoriteAction">收藏</span></label><p class="editor-hint" data-i18n="paper.localStateHint">精读和收藏只保存在本浏览器，不需要登录。</p></div>
      <section class="quick-read"><p class="eyebrow" data-i18n="paper.minuteRead">1–3 分钟阅读</p><h2 data-i18n="paper.quickRead">快速阅读</h2><span class="fact-label" data-i18n="paper.tldr">TL;DR</span><p>{paper.quick_read.tldr}</p><span class="fact-label" data-i18n="paper.problem">问题与动机</span><p>{paper.quick_read.problem_and_motivation}</p><span class="fact-label" data-i18n="paper.method">核心方法</span><p>{paper.quick_read.core_method}</p><span class="fact-label" data-i18n="paper.results">关键结果</span><p>{paper.quick_read.key_results}</p><span class="fact-label" data-i18n="paper.why">为什么重要 · AI 分析</span><p class="analysis">{paper.quick_read.why_it_matters}</p><button class="read-detail-button" data-read-detail data-i18n="paper.readDetail">阅读详情 ↓</button></section>
      <div class="detail-wrap" data-detail hidden>
        <section class="detail-section" id="motivation" tabindex="-1"><h2 data-i18n="paper.motivation">动机</h2>{asParagraphs(paper.detail.motivation).map((paragraph) => <p>{paragraph}</p>)}</section>
        <section class="detail-section" id="contributions"><h2 data-i18n="paper.contributions">论文贡献 / Contributions</h2><ul class="contributions">{paper.detail.contributions.map((item) => <li><span>{item.contribution}</span>{item.source && <small><strong data-i18n="paper.source">来源：</strong> {item.source}</small>}</li>)}</ul></section>
        <section class="detail-section" id="research-questions"><h2 data-i18n="paper.researchQuestions">研究问题</h2>{paper.detail.research_questions.length ? paper.detail.research_questions.map((rq) => <dl class="rq"><dt><span class="rq-type" data-i18n={rq.type === 'explicit' ? 'paper.explicitResearchQuestion' : 'paper.inferredResearchQuestion'}>{rq.type === 'explicit' ? '研究问题 / Research Question' : '隐含研究问题 / Inferred Research Question'}</span>{rq.question}{rq.type === 'explicit' && rq.original_question && <small class="rq-original">Original: {rq.original_question}</small>}</dt><dd><strong data-i18n="paper.how">如何：</strong> {rq.how}</dd><dd><strong data-i18n="paper.answer">答案：</strong> {rq.answer}</dd><dd><strong data-i18n="paper.meaning">含义：</strong> {rq.meaning}</dd>{rq.source && <dd><strong data-i18n="paper.source">来源：</strong> {rq.source}</dd>}</dl>) : <p data-i18n={paper.reading_basis === 'abstract_only' || paper.reading_basis === 'abstract_and_metadata' ? 'paper.insufficientResearchQuestionEvidence' : 'paper.noResearchQuestions'}>{paper.reading_basis === 'abstract_only' || paper.reading_basis === 'abstract_and_metadata' ? '当前阅读依据未覆盖 Introduction / Motivation，无法可靠推断研究问题。' : '未发现明确或可可靠推断的研究问题。'}</p>}</section>
        <section class="detail-section" id="method"><h2 data-i18n="paper.method">方法</h2>{asParagraphs(paper.detail.method).map((paragraph) => <p>{paragraph}</p>)}</section>
        <section class="detail-section" id="experiments"><h2 data-i18n="paper.experiments">实验与主要发现</h2>{asParagraphs(paper.detail.experiments_and_key_findings).map((paragraph) => <p>{paragraph}</p>)}</section>
        <section class="detail-section" id="limitations"><h2 data-i18n="paper.limitations">局限性</h2><span class="fact-label" data-i18n="paper.authorReported">作者报告</span><ul>{paper.detail.limitations.author_reported.map((x) => <li>{x}</li>)}</ul><span class="fact-label" data-i18n="paper.aiAnalysis">AI 分析</span><div class="analysis"><ul>{paper.detail.limitations.ai_analysis.map((x) => <li>{x}</li>)}</ul></div></section>
        <section class="detail-section" id="relation"><h2 data-i18n="paper.relation">与研究的关系</h2>{asParagraphs(paper.detail.relation_to_research).map((paragraph) => <p class="analysis">{paragraph}</p>)}</section>
        <section class="detail-section" id="next"><h2 data-i18n="paper.next">针对本文可进一步做什么</h2><div class="next-steps">{nextSteps.map((step) => <article class="next-step"><h3>{step.title}</h3><span class="fact-label" data-i18n="paper.nextRationale">为什么值得做</span>{asParagraphs(step.rationale).map((paragraph) => <p>{paragraph}</p>)}<span class="fact-label" data-i18n="paper.nextPlan">具体怎么做</span>{asParagraphs(step.concrete_plan).map((paragraph) => <p>{paragraph}</p>)}<span class="fact-label" data-i18n="paper.nextValidation">如何验证</span>{asParagraphs(step.validation).map((paragraph) => <p>{paragraph}</p>)}<span class="fact-label" data-i18n="paper.nextValue">预期价值</span>{asParagraphs(step.expected_value).map((paragraph) => <p>{paragraph}</p>)}{step.source && <small><strong data-i18n="paper.source">来源：</strong> {step.source}</small>}</article>)}</div></section>
        <section class="detail-section discussion" id="discussion"><h2 data-i18n="paper.discussion">评论 / Discussion</h2><div data-comments-list aria-live="polite"><p data-i18n="paper.commentsLoading">正在加载评论…</p></div><form data-comment-form><label><span data-i18n="paper.commentNickname">昵称</span><input name="nickname" maxlength="40" required data-i18n-placeholder="paper.commentNicknamePlaceholder" placeholder="你的昵称" /></label><label><span data-i18n="paper.commentBody">评论</span><textarea name="body" maxlength="2000" required data-i18n-placeholder="paper.commentBodyPlaceholder" placeholder="分享你的学术思考…"></textarea></label><input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="comment-honeypot" /><button class="editor-save" type="submit" data-i18n="paper.commentSubmit">发表评论</button><p class="editor-status" data-comment-status aria-live="polite"></p></form></section>
        <section class="detail-section" id="abstract"><details class="abstract"><summary data-i18n="paper.originalAbstract">原始摘要</summary><p>{paper.original_abstract || '没有保存摘要。'}</p></details>{paper.bibtex && <details class="bibtex"><summary data-i18n="paper.bibtex">BibTeX</summary><pre>{paper.bibtex}</pre><button class="text-button" data-copy-bibtex data-i18n="paper.copyBibtex">复制 BibTeX</button></details>}</section>
      </div>
      <div class="editor-panel" data-editor data-editor-state="checking" data-paper-id={paper.id} data-api={editorApi}>
        <div class="editor-heading"><div><h2 data-i18n="paper.ownerEditing">所有者编辑</h2><p class="editor-status" data-editor-status aria-live="polite" data-i18n="paper.editorChecking">正在检查安全编辑器…</p></div><div class="editor-session"><span data-editor-user hidden></span><button class="text-button" data-editor-login type="button" hidden data-i18n="paper.githubLogin">使用 GitHub 登录</button><button class="text-button" data-editor-logout type="button" hidden data-i18n="paper.signOut">退出登录</button></div></div>
        <form class="editor-form" data-user-editor hidden><fieldset><legend data-i18n="paper.readingState">个人状态与笔记</legend><label><span data-i18n="paper.editStatus">状态</span><select data-user-field="status"><option value="New">New</option><option value="Worth Reading">Worth Reading</option><option value="Reading">Reading</option><option value="Read">Read</option><option value="Important">Important</option><option value="Related Work">Related Work</option></select></label><label><span data-i18n="paper.tags">我的标签</span><input data-user-field="my_tags" type="text" placeholder="AI4SE, Agent" data-i18n-placeholder="paper.tagsPlaceholder" /></label><label><span data-i18n="paper.notes">我的笔记</span><textarea class="notes-area" data-user-field="my_notes" placeholder="私密、持久的 Markdown 笔记…" data-i18n-placeholder="paper.notesPlaceholder"></textarea></label><button class="editor-save" data-save-user type="submit" data-i18n="paper.savePersonal">保存阅读状态与笔记</button></fieldset></form>
        <details class="summary-editor" data-summary-editor hidden><summary data-i18n="paper.editAI">修正 AI 总结</summary><form class="editor-form" data-paper-editor><fieldset><legend>Quick Read</legend>{Object.entries(paper.quick_read).map(([field, value]) => <label><span>{field}</span><textarea data-summary-group="quick_read" data-summary-field={field}>{value}</textarea></label>)}</fieldset><fieldset><legend>Detail</legend>{(['motivation', 'method', 'experiments_and_key_findings', 'relation_to_research'] as const).map((field) => <label><span>{field}</span><textarea data-summary-group="detail" data-summary-field={field}>{paper.detail[field]}</textarea></label>)}<label><span>what_can_be_done_next (JSON)</span><textarea class="code-area" data-detail-next>{JSON.stringify(paper.detail.what_can_be_done_next, null, 2)}</textarea></label><label><span>contributions (JSON)</span><textarea class="code-area" data-contributions>{JSON.stringify(paper.detail.contributions, null, 2)}</textarea></label><label><span>research_questions (JSON)</span><textarea class="code-area" data-research-questions>{JSON.stringify(paper.detail.research_questions, null, 2)}</textarea></label><label><span>limitations.author_reported</span><textarea data-limitations="author_reported">{paper.detail.limitations.author_reported.join('\n')}</textarea></label><label><span>limitations.ai_analysis</span><textarea data-limitations="ai_analysis">{paper.detail.limitations.ai_analysis.join('\n')}</textarea></label><button class="editor-save" data-save-paper type="submit" data-i18n="paper.saveSummary">保存 AI 总结修正</button></fieldset></form></details>
        <p class="editor-status editor-hint" data-i18n="paper.notesHint">我的笔记和我的标签与生成的论文内容分开存储。写入需要 GitHub 所有者身份验证。</p><a class="editor-commit" data-editor-commit target="_blank" rel="noreferrer" hidden data-i18n="paper.viewCommit">查看 GitHub commit ↗</a>
      </div>
    </div>
    <aside class="toc"><strong data-i18n="paper.onThisPage">本页内容</strong><a href="#motivation" data-i18n="paper.motivation">动机</a><a href="#contributions" data-i18n="paper.contributions">论文贡献</a><a href="#research-questions" data-i18n="paper.researchQuestions">研究问题</a><a href="#method" data-i18n="paper.method">方法</a><a href="#experiments" data-i18n="paper.experiments">实验与主要发现</a><a href="#limitations" data-i18n="paper.limitations">局限性</a><a href="#relation" data-i18n="paper.relation">与研究的关系</a><a href="#next" data-i18n="paper.next">针对本文可进一步做什么</a><a href="#discussion" data-i18n="paper.discussion">评论 / Discussion</a><a href="#abstract" data-i18n="paper.originalAbstract">原始摘要</a></aside>
  </div>
  <div class="paper-footer-meta"><span><span data-i18n="paper.added">添加于：</span> {paper.generated_at.slice(0, 10)}</span><span><span data-i18n="paper.updated">最后更新：</span> {paper.updated_at.slice(0, 10)}</span><span><span data-i18n="paper.generated">摘要生成者：</span> {paper.generated_by}</span>{paper.owner_edited && <span data-i18n="paper.edited">所有者已编辑</span>}</div>
</Layout>
