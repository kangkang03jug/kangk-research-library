---
import Layout from '../../layouts/Layout.astro';
import { getProfile, getPapers, getStates } from '../../lib/data';
import { readingBasisLabel } from '../../lib/library';
import { withBase } from '../../lib/url';
export function getStaticPaths() { return getPapers().map((paper) => ({ params: { id: paper.id }, props: { paper, state: getStates().find((s) => s.paper_id === paper.id) } })); }
const { paper, state } = Astro.props;
const base = import.meta.env.BASE_URL;
const rank = paper.ranking.ccf || paper.ranking.cas || paper.ranking.jcr || 'Unknown';
const profile = getProfile();
---
<Layout title={paper.title} profile={profile}><article class="paper-head"><a class="eyebrow" href={withBase('/paper-pool/', base)} data-i18n="paper.backToPool">← 返回论文池</a><div class="paper-kicker"><span>{paper.year}</span><span>{paper.venue_or_source}</span><span>{rank}</span><span class={`relevance relevance-${paper.relevance.toLowerCase()}`}>{paper.relevance}</span></div><h1>{paper.title}</h1><p class="authors">{paper.authors.join(' · ')}</p><p class="reading-basis"><span data-i18n="paper.readingBasis">阅读依据：</span><strong>{readingBasisLabel[paper.reading_basis]}</strong></p><div class="paper-links"><a href={paper.urls.paper} target="_blank" rel="noreferrer" data-i18n="paper.paper">论文 ↗</a>{paper.urls.code && <a href={paper.urls.code} target="_blank" rel="noreferrer" data-i18n="paper.code">代码 ↗</a>}{paper.identifiers.doi && <span>DOI: {paper.identifiers.doi}</span>}</div></article>
  <div class="read-grid"><div class="reading-content"><section class="quick-read"><p class="eyebrow" data-i18n="paper.minuteRead">1–3 分钟阅读</p><h2 data-i18n="paper.quickRead">快速阅读</h2><span class="fact-label" data-i18n="paper.tldr">TL;DR</span><p>{paper.quick_read.tldr}</p><span class="fact-label" data-i18n="paper.problem">问题与动机</span><p>{paper.quick_read.problem_and_motivation}</p><span class="fact-label" data-i18n="paper.method">核心方法</span><p>{paper.quick_read.core_method}</p><span class="fact-label" data-i18n="paper.results">关键结果</span><p>{paper.quick_read.key_results}</p><span class="fact-label" data-i18n="paper.why">为什么重要 · AI 分析</span><p class="analysis">{paper.quick_read.why_it_matters}</p><button class="read-detail-button" data-read-detail data-i18n="paper.readDetail">阅读详情 ↓</button></section>
    <div class="detail-wrap" data-detail hidden><section class="detail-section" id="motivation" tabindex="-1"><h2 data-i18n="paper.motivation">动机</h2><p>{paper.detail.motivation}</p></section><section class="detail-section" id="research-questions"><h2 data-i18n="paper.researchQuestions">研究问题</h2>{paper.detail.research_questions.length ? paper.detail.research_questions.map((rq) => <dl class="rq"><dt>{rq.question}</dt><dd><strong data-i18n="paper.how">如何：</strong> {rq.how}</dd><dd><strong data-i18n="paper.answer">答案：</strong> {rq.answer}</dd><dd><strong data-i18n="paper.meaning">含义：</strong> {rq.meaning}</dd>{rq.source && <dd><strong data-i18n="paper.source">来源：</strong> {rq.source}</dd>}</dl>) : <p data-i18n="paper.noExplicitRQs">论文没有明确列出研究问题。</p>}</section><section class="detail-section" id="method"><h2 data-i18n="paper.method">方法</h2><p>{paper.detail.method}</p></section><section class="detail-section" id="experiments"><h2 data-i18n="paper.experiments">实验与主要发现</h2><p>{paper.detail.experiments_and_key_findings}</p></section><section class="detail-section" id="limitations"><h2 data-i18n="paper.limitations">局限性</h2><span class="fact-label" data-i18n="paper.authorReported">作者报告</span><ul>{paper.detail.limitations.author_reported.map((x) => <li>{x}</li>)}</ul><span class="fact-label" data-i18n="paper.aiAnalysis">AI 分析</span><div class="analysis"><ul>{paper.detail.limitations.ai_analysis.map((x) => <li>{x}</li>)}</ul></div></section><section class="detail-section" id="relation"><h2 data-i18n="paper.relation">与研究的关系</h2><p class="analysis">{paper.detail.relation_to_research}</p></section><section class="detail-section" id="next"><h2 data-i18n="paper.next">下一步可以做什么</h2><p class="analysis">{paper.detail.what_can_be_done_next}</p></section><section class="detail-section" id="abstract"><details class="abstract"><summary data-i18n="paper.originalAbstract">原始摘要</summary><p>{paper.original_abstract || '没有保存摘要。'}</p></details>{paper.bibtex && <details class="bibtex"><summary data-i18n="paper.bibtex">BibTeX</summary><pre>{paper.bibtex}</pre><button class="text-button" data-copy-bibtex data-i18n="paper.copyBibtex">复制 BibTeX</button></details>}</section></div>
    <div class="editor-panel" data-editor data-api={import.meta.env.PUBLIC_EDITOR_API_URL || ''}><h2 data-i18n="paper.ownerEditing">所有者编辑</h2><p class="editor-status" data-editor-status data-i18n="paper.editorChecking">正在检查安全编辑器…</p><div class="editor-actions"><button data-edit-action type="button" data-i18n="paper.markDeepRead">标记为精读</button><button data-edit-action type="button" data-i18n="paper.favoriteAction">收藏</button><button data-edit-action type="button" data-i18n="paper.editStatus">编辑状态</button><button data-edit-action type="button" data-i18n="paper.editAI">编辑 AI 内容</button></div><label><span data-i18n="paper.notes">我的笔记</span><textarea class="notes-area" data-notes placeholder="私密、持久的 Markdown 笔记…" data-i18n-placeholder="paper.notesPlaceholder">{state?.my_notes || ''}</textarea></label><p class="editor-status" data-i18n="paper.notesHint">我的笔记和我的标签与生成的论文内容分开存储。写入需要 GitHub 所有者身份验证。</p></div>
  </div><aside class="toc"><strong data-i18n="paper.onThisPage">本页内容</strong><a href="#motivation" data-i18n="paper.motivation">动机</a><a href="#research-questions" data-i18n="paper.researchQuestions">研究问题</a><a href="#method" data-i18n="paper.method">方法</a><a href="#experiments" data-i18n="paper.experiments">实验与主要发现</a><a href="#limitations" data-i18n="paper.limitations">局限性</a><a href="#relation" data-i18n="paper.relation">与研究的关系</a><a href="#next" data-i18n="paper.next">下一步可以做什么</a><a href="#abstract" data-i18n="paper.originalAbstract">原始摘要</a></aside></div><div class="paper-footer-meta"><span><span data-i18n="paper.added">添加于：</span> {paper.generated_at.slice(0, 10)}</span><span><span data-i18n="paper.updated">最后更新：</span> {paper.updated_at.slice(0, 10)}</span><span><span data-i18n="paper.generated">摘要生成者：</span> {paper.generated_by}</span>{paper.owner_edited && <span data-i18n="paper.edited">所有者已编辑</span>}</div></Layout>
