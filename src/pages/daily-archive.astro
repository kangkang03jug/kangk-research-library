---
import Layout from '../layouts/Layout.astro';
import { getProfile, getPapers, getDaily } from '../lib/data';
import { withBase } from '../lib/url';
const profile = getProfile();
const papers = getPapers();
const daily = [...getDaily()].sort((a, b) => b.date.localeCompare(a.date));
---
<Layout title="Daily Archive" profile={profile}><section class="page-head"><div><p class="eyebrow" data-i18n="pages.recommendationHistory">推荐历史</p><h1 data-i18n="pages.dailyArchive">每日归档</h1><p class="lede" data-i18n="pages.dailyArchiveLede">每条推荐一行，重复运行也不会重复创建论文记录。</p></div><span class="count" data-count-value={daily.length} data-count-kind="day">{daily.length} 天</span></section><div class="archive-list">{daily.length ? daily.map((day) => <section class="detail-section"><div class="section-label"><h2>{day.date}</h2><span class="count" data-count-value={day.recommendations.length} data-count-kind="recommendation">{day.recommendations.length} 条推荐</span></div>{day.recommendations.map((rec) => <div class="paper-row"><div><div class="paper-kicker"><span>{rec.primary ? 'Primary' : 'Additional'}</span><span>{rec.run_type}</span></div><h2><a href={withBase(`/papers/${rec.paper_id}/`, import.meta.env.BASE_URL)}>{papers.find((p) => p.id === rec.paper_id)?.title || rec.paper_id}</a></h2></div></div>)}</section>) : <div class="empty"><strong data-i18n="pages.noRecommendations">还没有推荐记录。</strong><span data-i18n="pages.agentArchive">每日 Agent 会在这里归档第一次运行。</span></div>}</div></Layout>
