---
import Layout from '../layouts/Layout.astro'; import { getProfile, getPapers, getDaily } from '../lib/data'; const profile=getProfile(); const papers=getPapers(); const daily=[...getDaily()].sort((a,b)=>b.date.localeCompare(a.date));
---
<Layout title="Daily Archive" profile={profile}><section class="page-head"><div><p class="eyebrow">Recommendation history</p><h1>Daily Archive</h1><p class="lede">One line per recommendation, so repeated runs never duplicate the paper record.</p></div><span class="count">{daily.length} days</span></section><div class="archive-list">{daily.length ? daily.map((day)=><section class="detail-section"><div class="section-label"><h2>{day.date}</h2><span class="count">{day.recommendations.length} recommendation{day.recommendations.length===1?'':'s'}</span></div>{day.recommendations.map((rec)=><div class="paper-row"><div><div class="paper-kicker"><span>{rec.primary?'Primary':'Additional'}</span><span>{rec.run_type}</span></div><h2><a href={`${import.meta.env.BASE_URL}papers/${rec.paper_id}/`}>{papers.find(p=>p.id===rec.paper_id)?.title || rec.paper_id}</a></h2></div></div>)}</section>) : <div class="empty"><strong>No recommendations yet.</strong>The daily agent will archive its first run here.</div>}</div></Layout>
