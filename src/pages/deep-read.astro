---
import Layout from '../layouts/Layout.astro';
import PaperCard from '../components/PaperCard.astro';
import { getProfile, getPapers, getStates } from '../lib/data';
import { joinState } from '../lib/library';
const profile = getProfile();
const joined = joinState(getPapers(), getStates());
---
<Layout title="Deep Read" profile={profile}><section class="page-head"><div><p class="eyebrow" data-i18n="pages.readingProgress">阅读进度</p><h1 data-i18n="pages.deepRead">精读</h1><p class="lede" data-i18n="pages.deepReadLede">你在详情页阅读后标记的论文。</p></div><span class="count" data-local-count data-count-value="0" data-count-kind="paper">0 篇论文</span></section><div class="paper-list" data-local-state-filter="deep_read">{joined.map(({ paper, state }) => <PaperCard paper={paper} state={state} />)}</div><div class="empty" data-local-empty hidden><strong data-i18n="pages.noDeepReads">还没有精读论文。</strong><span data-i18n="pages.useDeepRead">阅读详情后使用“标记为精读”。</span></div></Layout>
