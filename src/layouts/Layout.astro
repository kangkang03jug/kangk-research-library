---
import '../styles/global.css';
import { withBase } from '../lib/url';
const { title, profile } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  ['nav.home', '首页', withBase('/', base)],
  ['nav.paperPool', '论文池', withBase('/paper-pool/', base)],
  ['nav.deepRead', '精读', withBase('/deep-read/', base)],
  ['nav.dailyArchive', '每日归档', withBase('/daily-archive/', base)],
  ['nav.favorites', '收藏', withBase('/favorites/', base)],
];
---
<!doctype html>
<html lang="zh-CN" data-locale="zh-CN" data-state-namespace={base}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={profile?.profile?.description || 'A reusable research library framework'} />
    <title>{title ? `${title} · ` : ''}{profile?.profile?.library_name || 'Research Library'}</title>
    <script is:inline>
      try {
        const locale = localStorage.getItem('research-library-locale') === 'en' ? 'en' : 'zh-CN';
        document.documentElement.dataset.locale = locale;
        document.documentElement.lang = locale;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/', base)} aria-label="首页"><span class="brand-mark">R/</span><span>{profile?.profile?.library_name || 'Research Library'}</span></a>
      <nav aria-label="主导航">{nav.map(([key, label, href]) => <a href={href} data-i18n={key}>{label}</a>)}</nav>
      <div class="header-actions">
        <button class="locale-toggle" type="button" data-locale-toggle aria-label="切换为 English">中 / EN</button>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深色模式">◐</button>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><span data-i18n="footer.content">结构化数据存储在 Git · 内容优先</span><span data-i18n="footer.generated">由 ChatGPT/Codex 生成</span></footer>
    <script is:inline>
      const key = 'research-library-theme';
      const saved = localStorage.getItem(key);
      if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.dataset.theme = 'dark';
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => { const dark = document.documentElement.dataset.theme === 'dark'; document.documentElement.dataset.theme = dark ? 'light' : 'dark'; localStorage.setItem(key, dark ? 'light' : 'dark'); });
    </script>
    <script src="../scripts/library.js"></script>
  </body>
</html>
